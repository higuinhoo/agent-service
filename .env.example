# Variáveis de ambiente — NÃO commitar .env (apenas este exemplo)

# ─── Banco de dados ───────────────────────────────────────────────
DATABASE_URL=postgresql://crm:crm_secret@localhost:5432/crm_db

# ─── Auth ─────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=troque-por-valor-aleatorio-seguro-em-producao

# ─── IA ───────────────────────────────────────────────────────────
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...

# ─── WAHA ─────────────────────────────────────────────────────────
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=troque-por-chave-segura
WAHA_WEBHOOK_HMAC_SECRET=troque-por-segredo-hmac-seguro
WAHA_SESSION=default

# ─── App ──────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
